+    void FFT2D5Algorithm::scatterContainer(
+            size_t container, DiagnosticPolicy diagnostic, bool usePreparedProjections) {
+        const auto ref      = solveReferencePath_m;
+        const auto invDr    = 1.0 / fieldStorage_m->spacing();
