+    // Direct real-space convolution is independent of the production FFT and
+    // corner primitive. The deposited source is tested separately by CIC tests.
+    template <typename HostView>
+    double referenceGridPotential(
+            const HostView& source, size_t i, size_t j, size_t k, double hx, double hy) {
+        double result = 0.0;
+        for (size_t sx = 1; sx + 1 < source.extent(0); ++sx) {
+            for (size_t sy = 1; sy + 1 < source.extent(1); ++sy) {
+                if (source(sx, sy, k) != 0.0) {
+                    result += source(sx, sy, k) * hx * hy / Physics::epsilon_0
+                              * referenceCellPotential(
+                                      (static_cast<double>(i) - sx) * hx,
+                                      (static_cast<double>(j) - sy) * hy, hx, hy);
+                }
+            }
+        }
+        return result;
+    }
+
+    template <typename HostView>
+    std::array<double, 2> referenceGridField(
+            const HostView& source, size_t i, size_t j, size_t k, double hx, double hy) {
+        return {(referenceGridPotential(source, i - 1, j, k, hx, hy)
+                 - referenceGridPotential(source, i + 1, j, k, hx, hy))
+                        / (2 * hx),
+                (referenceGridPotential(source, i, j - 1, k, hx, hy)
+                 - referenceGridPotential(source, i, j + 1, k, hx, hy))
+                        / (2 * hy)};
+    }
+
+    double referenceTwoParticleForce() {
+        // In the 0.5-m slices the two unit-charge particles at x=+/-2 m
+        // each deposit line charge 1 C/m. Both transverse CIC shapes have
+        // four equal weights. Directly integrate each uniform source cell,
+        // central-difference its potential, then gather those four fields.
+        static const double force = [] {
+            double result = 0.0;
+            for (const double tx : {1.75, 2.25}) {
+                for (const double ty : {-0.25, 0.25}) {
+                    for (const double center : {-2.0, 2.0}) {
+                        for (const double sx : {center - 0.25, center + 0.25}) {
+                            for (const double sy : {-0.25, 0.25}) {
+                                result +=
+                                        (referenceCellPotential(tx - sx - 0.5, ty - sy, 0.5, 0.5)
+                                         - referenceCellPotential(tx - sx + 0.5, ty - sy, 0.5, 0.5))
+                                        / (16.0 * Physics::epsilon_0);
+                            }
+                        }
+                    }
+                }
+            }
+            return result;
+        }();
+        return force;
+    }
+
+    // Grounded round-pipe potential per unit line charge. Integrate the
+    // Gauss-law radial field in real space instead of reproducing the
+    // production longitudinal geometry factor. Split at the beam surface so
+    // Simpson quadrature sees smooth integrands on both intervals.
+    double referenceUniformRoundPipePotential(
+            const double radius, const double beamRadius, const double pipeRadius) {
+        const auto integrate = [](const double low, const double high, const auto& field) {
+            constexpr int intervals = 1024;
+            if (low == high) {
+                return 0.0;
+            }
+            const double step = (high - low) / intervals;
+            double sum        = field(low) + field(high);
+            for (int i = 1; i < intervals; ++i) {
+                sum += (i % 2 == 0 ? 2.0 : 4.0) * field(low + i * step);
+            }
+            return sum * step / 3.0;
+        };
+        const auto interior = [beamRadius](const double r) {
+            return r / (2 * Physics::pi * Physics::epsilon_0 * beamRadius * beamRadius);
+        };
+        const auto exterior = [](const double r) {
+            return 1 / (2 * Physics::pi * Physics::epsilon_0 * r);
+        };
+        if (radius < beamRadius) {
+            return integrate(radius, beamRadius, interior)
+                   + integrate(beamRadius, pipeRadius, exterior);
+        }
+        return integrate(radius, pipeRadius, exterior);
+    }
+
+    double referenceTriangularPipeField(
+            const double radius, const double z, const double beamRadius,
+            const double pipeRadius, const double longitudinalMomentum) {
+        constexpr double halfLength = 3.0, peakLineCharge = 1e-9, derivativeStep = 0.01;
+        const auto potential = [&](const double coordinate) {
+            const double lineCharge =
+                    peakLineCharge * (1 - std::abs(coordinate - halfLength) / halfLength);
+            return lineCharge
+                   * referenceUniformRoundPipePotential(radius, beamRadius, pipeRadius);
+        };
+        // A prescribed moving source has E_s=-gamma^-2*d(phi_lab)/ds.
+        // All targets lie on a linear branch, far from the cusp and ends.
+        return -(potential(z + derivativeStep) - potential(z - derivativeStep))
+               / (2 * derivativeStep * (1 + longitudinalMomentum * longitudinalMomentum));
+    }
