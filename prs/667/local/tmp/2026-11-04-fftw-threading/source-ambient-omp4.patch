 target_link_libraries(opalx PRIVATE OPALX::lapacke)
 
+# FFTW threading is optional: heFFTe also accepts serial-only FFTW installations.
+# Probe the actual imported link interface, without modifying IPPL or heFFTe.
+if(TARGET Heffte::FFTW)
+  include(CMakePushCheckState)
+  include(CheckCXXSourceCompiles)
+  cmake_push_check_state(RESET)
+  set(CMAKE_REQUIRED_LIBRARIES Heffte::FFTW)
+  unset(OPALX_HAVE_FFTW_THREADS CACHE)
+  check_cxx_source_compiles("#include <fftw3.h>
+    int main() {
+      if (!fftw_init_threads()) return 1;
+      fftw_plan_with_nthreads(1);
+      return fftw_planner_nthreads() != 1;
+    }" OPALX_HAVE_FFTW_THREADS)
+  cmake_pop_check_state()
+  if(OPALX_HAVE_FFTW_THREADS)
+    target_compile_definitions(opalx PUBLIC OPALX_HAVE_FFTW_THREADS=1)
+  endif()
+endif()
+
 target_include_directories(opalx PRIVATE
   ${HDF5_INCLUDE_DIR}
   ${H5HUT_INCLUDE_DIR}
