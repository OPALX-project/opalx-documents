+def resolve_physics_validator(value: Path, test_directory: Path) -> Path:
+    """Require a case-local Python script, without absolute paths or escapes."""
+    if value.is_absolute():
+        raise SmokeRunnerError("--physics-validator must be relative to the copied test")
+    script = (test_directory / value).resolve()
+    if not is_within(script, test_directory.resolve()):
+        raise SmokeRunnerError("--physics-validator must stay within the copied test")
+    if not script.is_file():
+        raise SmokeRunnerError(f"physics validator does not exist: {script}")
+    return script
+
+
+def run_physics_validator(
+    script: Path,
+    stat_path: Path,
+    work_directory: Path,
+    artifact_directory: Path,
+    timeout: Optional[float],
+) -> Dict[str, Any]:
+    """Run the explicit validator and retain its report and process diagnostics."""
+    report_path = artifact_directory / "physics-validation.json"
+    if report_path.exists():
+        report_path.unlink()
+    command = [
+        sys.executable,
+        str(script),
+        "--stat",
+        str(stat_path),
+        "--output",
+        str(report_path),
+    ]
+    result: Dict[str, Any] = {"command": command, "report_path": str(report_path)}
+    stdout_path = artifact_directory / "physics-validator.stdout.log"
+    stderr_path = artifact_directory / "physics-validator.stderr.log"
+    try:
+        with stdout_path.open("w", encoding="utf-8") as stdout_stream, stderr_path.open(
+            "w", encoding="utf-8"
+        ) as stderr_stream:
+            completed = subprocess.run(
+                command,
+                cwd=work_directory,
+                stdout=stdout_stream,
+                stderr=stderr_stream,
+                check=False,
+                timeout=timeout,
+            )
+        result["return_code"] = completed.returncode
+    except subprocess.TimeoutExpired:
+        result.update({"passed": False, "error": "physics validator timed out"})
+        return result
+    except OSError as error:
+        result.update({"passed": False, "error": f"cannot launch physics validator: {error}"})
+        return result
+
+    try:
+        report = json.loads(report_path.read_text(encoding="utf-8"))
+        if not isinstance(report, dict) or not isinstance(report.get("passed"), bool):
+            raise ValueError("physics report must contain a boolean 'passed' value")
+        result["report"] = report
+        result["passed"] = completed.returncode == 0 and report["passed"]
+    except (OSError, ValueError) as error:
+        result.update({"passed": False, "error": f"invalid physics report: {error}"})
+    return result
+
