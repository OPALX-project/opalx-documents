+void FFT2D5Poisson::initializeFFTWThreading() {
+#ifdef OPALX_HAVE_FFTW_THREADS
+    if constexpr (std::is_same_v<MemSpace, Kokkos::HostSpace>) {
+        static const bool initialized = [] {
+            if (fftw_init_threads() == 0) return false;
+#ifdef _OPENMP
+            fftw_threads_set_callback(fftwParallelLoop, nullptr);
+#endif
+            return true;
+        }();
+        if (!initialized)
+            throw OpalException("FFT2D5Poisson", "FFTW thread initialization failed.");
+    }
+#endif
+}
+
+int FFT2D5Poisson::setFFTWPlannerThreads(int threads) {
+    if (threads < 1) throw OpalException("FFT2D5Poisson", "Positive FFTW thread count required.");
+#ifdef OPALX_HAVE_FFTW_THREADS
+    if constexpr (std::is_same_v<MemSpace, Kokkos::HostSpace>) {
+        initializeFFTWThreading();
+        const int previous = fftw_planner_nthreads();
+        fftw_plan_with_nthreads(threads);
+        return previous;
+    }
+#endif
+    if (threads != 1)
+        throw OpalException(
+                "FFT2D5Poisson",
+                "--2D5FFTThreads greater than one requires a thread-enabled host FFTW backend.");
+    return 1;
+}
