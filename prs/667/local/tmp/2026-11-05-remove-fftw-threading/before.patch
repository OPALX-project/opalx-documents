+namespace {
+    // FFTW's built-in OpenMP backend uses an unqualified parallel-for, hence
+    // OMP_NUM_THREADS. This supported callback instead honors the plan's job
+    // count per region, without changing Kokkos's ambient OpenMP team size.
+    void fftwParallelLoop(void* (*work)(char*), char* jobs, size_t stride, int count, void*) {
+#pragma omp parallel for num_threads(count) schedule(static)
+        for (int i = 0; i < count; ++i)
