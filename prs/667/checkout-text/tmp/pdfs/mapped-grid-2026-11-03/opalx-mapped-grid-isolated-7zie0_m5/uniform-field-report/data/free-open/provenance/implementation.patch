+                gamma = containerGamma;
+                haveGamma = true;
+            }
+        }
+        if (!solveGeometry_m.isStraight()) {
+            const double maximumBetaSquared = maximumMomentumSquared / (1 + maximumMomentumSquared);
+            // A curved bunch has no single inertial rest frame. This finite-arc
+            // backend solves instantaneous electrostatics; the neglected dynamic
+            // terms are O(beta^2). Do not silently apply a straight-beam boost.
+            if (maximumBetaSquared > 0.01) {
+                throw OpalException(
+                        "FFT2D5Algorithm::solveFreeSpace",
+                        "Curved OPEN finite-source fields currently require beta <= 0.1. "
+                        "Relativistic curved-beam electrodynamics is not implemented.");
+            }
+            gamma = 1.0;
+        }
+        freeSpaceFieldsReady_m = false;
+        freeSpaceSolves_m = freeSpace_m->solve(
+                fieldStorage_m->chargeDensity(), fieldStorage_m->electricField(),
+                solveGeometry_m.signedCurvature(), gamma);
+        freeSpaceFieldsReady_m = true;
+    }
