+        TEST(SpaceChargeConfigTest, CircularModesRejectInvalidPhysicalPipeRadii) {
+            for (const auto mode :
+                 {FFT2D5LongitudinalFieldMode::Cylindrical,
+                  FFT2D5LongitudinalFieldMode::UniformRound}) {
+                FFT2D5Config config;
+                config.longitudinalFieldMode = mode;
+                config.beamRadius            = 0.005;
+                for (const double radius :
+                     {0.0, -0.020, 0.004, std::numeric_limits<double>::infinity(),
+                      std::numeric_limits<double>::quiet_NaN()}) {
+                    config.pipeRadius = radius;
+                    EXPECT_THROW(validateSpaceChargeConfig(config), OpalException);
+                }
+                config.pipeRadius = config.beamRadius;
+                EXPECT_NO_THROW(validateSpaceChargeConfig(config));
+            }
+        }
