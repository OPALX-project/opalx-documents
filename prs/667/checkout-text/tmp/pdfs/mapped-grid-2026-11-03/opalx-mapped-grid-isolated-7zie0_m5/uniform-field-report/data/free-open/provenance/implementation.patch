+    void FFT2D5Algorithm::solveFreeSpace(const SpaceChargeSolveContext& context) {
+        double gamma = 1.0;
+        bool haveGamma = false;
+        double maximumMomentumSquared = 0.0;
+        for (std::size_t index = 0; index < particles_m.size(); ++index) {
+            if (context.trackingActive()[index] == 0) continue;
