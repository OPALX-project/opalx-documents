+            double localMaximum = 0.0;
+            Kokkos::parallel_reduce(
+                    "FFT2D5::maximumMomentum", pc->getLocalNum(),
+                    KOKKOS_LAMBDA(const std::size_t n, double& maximum) {
+                        if (!invalid(n)) maximum = Kokkos::max(maximum, p(n).dot(p(n)));
+                    }, Kokkos::Max<double>(localMaximum));
