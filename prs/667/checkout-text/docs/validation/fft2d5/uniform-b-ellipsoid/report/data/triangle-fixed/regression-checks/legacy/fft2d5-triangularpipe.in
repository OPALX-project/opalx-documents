// Frozen, nonzero longitudinal field in a prescribed round beam and grounded pipe.
OPTION, VERSION=10900;
OPTION, PSDUMPFREQ=1;
OPTION, STATDUMPFREQ=1;
OPTION, EBDUMP=TRUE;
OPTION, MINBINEMITTED=0;
DIST1: DISTRIBUTION,TYPE=FROMFILE,NPARTDIST=65546,FNAME="triangle.dist";
E1: EMISSIONSOURCE,DISTRIBUTION=DIST1,R0X=0,R0Y=0,R0Z=0,P0X=0,P0Y=0,P0Z=0,T0=0,ZEROFACE_R0Z=FALSE,SHIFTED_GREENS_FUNCTION=FALSE,ZEROFACEPLANEDUMP=0,ZEROFACE_MAXSTEPS=0,EMISSIONMODEL=NONE,EKIN=0;
ELIST1: EMISSIONSOURCELIST=(E1);
FS: FIELDSOLVER,TYPE="FFT2D5",NX=32,NY=32,NZ=64,PARFFTX=FALSE,PARFFTY=FALSE,PARFFTZ=FALSE,PIPEMODE="CIRCULAR",PIPERADIUS=0.020,BEAMR=0.005,PIPESIZEX=0.060,PIPESIZEY=0.060,CLOSEDRING=FALSE,SCATTERLONGITUDINALLY=TRUE,REFPATHFNAME="reference_path.dat";
B1: BEAM,PARTICLE=PROTON,NALLOC=65546,BCHARGE=1.6024211067529903e-05,SOURCES="ELIST1";
D1: DRIFT,L=1,ELEMEDGE=1000;
L1: LINE=(D1);
TRACK,BEAM=B1,LINE=L1,MAXSTEPS=1,ZSTOP={100},DT={9.9999999999999995e-21};
RUN,FIELDSOLVER=FS,METHOD="PARALLEL",TURNS=1;
ENDTRACK;
