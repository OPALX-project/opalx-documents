+            const int my = static_cast<int>(fsCmd_m->getNY());
+            const int mz = static_cast<int>(fsCmd_m->getNZ());
+            const double wx = fsCmd_m->getPipeSizeX(), wy = fsCmd_m->getPipeSizeY();
+            const double dx = wx / mx, dy = wy / my, dz = 6.0 / mz;
+            const double beamRadius = fsCmd_m->getBeamRadius();
+            std::vector<std::array<int, 2>> occupied;
+            for (int i = 0; i < mx; ++i) {
+                for (int j = 0; j < my; ++j) {
+                    const double x = -0.5 * wx + (i + 0.5) * dx;
+                    const double y = -0.5 * wy + (j + 0.5) * dy;
+                    if (x * x + y * y < beamRadius * beamRadius) {
+                        occupied.push_back({i, j});
