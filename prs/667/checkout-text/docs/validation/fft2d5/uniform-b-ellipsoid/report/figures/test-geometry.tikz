% Native vector schematic. Units and rotations follow main.tex, Eq. (1).
% Screen-right = OPALX +z, screen-up = OPALX +x, hence +y out of page.
\begin{tikzpicture}[
  x=1cm,y=1cm,
  font=\small,
  >=Latex,
  axis/.style={->,line width=.65pt,black!70},
  dimension/.style={<->,line width=.6pt,black!75},
  localaxis/.style={->,line width=.9pt,blue!65!black},
  orbit/.style={line width=1.25pt,blue!65!black},
  guide/.style={line width=.45pt,dashed,black!35},
  bunch/.style={draw=blue!65!black,fill=blue!12,line width=.8pt},
  labelbox/.style={fill=white,inner sep=2pt}
 ]
 \path[use as bounding box] (0,0.55) rectangle (16.3,10.25);
 \node[font=\bfseries\small] at (4.1,9.9) {(a) Circular orbit and moving basis};
 \node[font=\bfseries\small] at (12.15,9.9) {(b) Initial uniform-volume ellipsoid};
 \draw[black!15] (8.1,1.05) -- (8.1,9.45);

 % Global laboratory orbit: (z,x+R) = (R sin(theta), R cos(theta)).
 \coordinate (O) at (3.5,5.8);
 \coordinate (C) at ($(O)+(37:2.55)$);
 \coordinate (Czero) at ($(O)+(78.540844:2.55)$);
 \coordinate (Cend) at ($(O)+(-101.459156:2.55)$);
 \draw[guide] (O) circle[radius=2.55];
 \draw[orbit,
   postaction={decorate},
   decoration={markings,mark=at position .61 with {\arrow{Latex}}}]
   (Czero) arc[start angle=78.540844,end angle=-101.459156,radius=2.55];
 \draw[axis] ($(O)+(-.55,0)$) -- ($(O)+(3.7,0)$) node[right] {$+z$};
 \draw[axis] ($(O)+(0,-.55)$) -- ($(O)+(0,3.35)$) node[above] {$+x$};
 \fill (O) circle[radius=1.3pt];
 \node[anchor=north east,align=right] at ($(O)+(-.15,-.2)$)
   {$O$\\[-2pt]$(-R,0,0)$};
 \draw[->,line width=.7pt] (O) -- (C)
   node[pos=.48,above left=1pt,labelbox] {$R=1\,\mathrm m$};

 % Tangentially long bunch; enlarged relative to the orbit.
 \begin{scope}[shift={(C)},rotate=-53]
   \draw[bunch] (0,0) ellipse[x radius=.8,y radius=.08];
 \end{scope}
 \fill[blue!65!black] (C) circle[radius=1.5pt];
 \node[labelbox,anchor=north east] at ($(C)+(-.14,-.12)$) {$\bm C(t)$};
 \draw[localaxis] (C) -- ($(C)+(37:1.15)$)
   node[above right=-1pt] {$\bm e_r$};
 \draw[localaxis] (C) -- ($(C)+(-53:1.4)$)
   node[right,align=left] {$\bm e_s$\\[-1pt]$\bm v_c\parallel\bm e_s$};
 \fill[blue!65!black] (Czero) circle[radius=1.6pt];
 \node[anchor=south west,labelbox] at ($(Czero)+(.12,.09)$)
   {$\bm C(0)$};
 \fill[blue!65!black] (Cend) circle[radius=1.6pt];
 \node[anchor=north west,labelbox] at ($(Cend)+(.08,-.13)$)
   {$\bm C(\pi/\Omega)$};

 % Field normal: positive y points toward the reader in this projection.
 \draw[line width=.9pt] (1.1,8.35) circle[radius=.16];
 \fill (1.1,8.35) circle[radius=.042];
 \node[anchor=north,align=center] at (1.1,8.05)
   {$+B_y$\\[-1pt]out of page};
 \node[align=center,text width=6.6cm,font=\small] at (3.9,1.45)
   {Uniform $B_y=B_Z^{\rm physical}=31.2974\,\mathrm{mT}$\\
    Half-turn; $\beta_c=0.01$; bunch enlarged};

 % Orbit-plane ellipsoid projection. Ratio a_s/a_r = 10 is preserved here.
 \node[align=center] at (12.2,8.85) {Orbit-plane projection $(s,r)$};
 \coordinate (P) at (12.05,7.45);
 \draw[bunch] (P) ellipse[x radius=2.45,y radius=.245];
 \draw[axis] ($(P)+(-2.65,0)$) -- ($(P)+(3.1,0)$) node[right] {$s$};
 \draw[axis] (P) -- ($(P)+(0,1.0)$) node[above] {$r$};
 \fill (P) circle[radius=1.3pt];
 \draw[guide] (P) -- ($(P)+(0,-.9)$);
 \draw[guide] ($(P)+(2.45,0)$) -- ($(P)+(2.45,-.9)$);
 \draw[dimension] ($(P)+(0,-.7)$) -- ($(P)+(2.45,-.7)$)
   node[midway,below=3pt] {$a_s=50\,\mathrm{mm}$};
 \draw[->,line width=.6pt] ($(P)+(-1.45,.9)$) -- ($(P)+(-.65,.235)$);
 \node[anchor=south,align=center] at ($(P)+(-1.45,.9)$)
   {$a_r=5\,\mathrm{mm}$};

 % Independently magnified thin cross-section. Ratio a_r/a_y = 10.
 \node[align=center] at (12.2,4.95)
   {Transverse section $(r,y)$\\[-1pt]\footnotesize separately magnified};
 \coordinate (S) at (12.05,3.35);
 \draw[bunch] (S) ellipse[x radius=2.45,y radius=.245];
 \draw[axis] ($(S)+(-2.65,0)$) -- ($(S)+(3.1,0)$) node[right] {$r$};
 \draw[axis] (S) -- ($(S)+(0,1.0)$) node[above] {$y$};
 \fill (S) circle[radius=1.3pt];
 \draw[guide] (S) -- ($(S)+(0,-.9)$);
 \draw[guide] ($(S)+(2.45,0)$) -- ($(S)+(2.45,-.9)$);
 \draw[dimension] ($(S)+(0,-.7)$) -- ($(S)+(2.45,-.7)$)
   node[midway,below=3pt] {$a_r=5\,\mathrm{mm}$};
 \draw[->,line width=.6pt] ($(S)+(-1.5,.9)$) -- ($(S)+(-.65,.235)$);
 \node[anchor=south,align=center] at ($(S)+(-1.5,.9)$)
   {$a_y=0.5\,\mathrm{mm}$};
 \node[font=\small,align=center] at (12.2,1.3)
   {$a_s:a_r:a_y=100:10:1$\\Cold rigid corotation};
\end{tikzpicture}
