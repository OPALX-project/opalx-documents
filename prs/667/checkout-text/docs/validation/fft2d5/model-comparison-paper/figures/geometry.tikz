\begin{tikzpicture}[>=Latex,font=\small,line cap=round,line join=round]
\definecolor{beam}{RGB}{0,114,178}
\begin{scope}[shift={(0,0)}]
 \node[font=\bfseries] at (2.25,1.15) {Straight};
 \fill[beam!15] (0,-.23) rectangle (4.5,.23);
 \draw[beam] (0,-.23)--(4.5,-.23) (0,.23)--(4.5,.23);
 \draw[beam,fill=beam!8] (0,0) ellipse (.09 and .23);
 \draw[beam] (4.5,0) ellipse (.09 and .23);
 \draw[dashed,gray] (-.2,0)--(4.8,0);
 \draw[<->] (0,-.65)--node[fill=white] {$L=5$ m}(4.5,-.65);
 \draw[->] (2.25,0)--(3.1,0) node[above] {$s$};
 \draw[->] (2.25,0)--(2.25,.7) node[right] {$u=x$};
\end{scope}
\begin{scope}[shift={(7.5,.05)},scale=.82]
 \node[font=\bfseries] at (0,1.34) {Circular};
 \draw[beam!20,line width=9pt] (0,-2) ++(161.6197:2)
   arc[start angle=161.6197,end angle=18.3803,radius=2];
 \draw[beam,thick] (0,-2) ++(161.6197:2)
   arc[start angle=161.6197,end angle=18.3803,radius=2];
 \fill (0,-2) circle (1.5pt) node[below] {$C$};
 \draw[<->] (0,-2)--node[left] {$R=2$ m}(0,0);
 \draw[->] (0,0)--(.9,0) node[above] {$\mathbf e_s$};
 \draw[->] (0,0)--(0,.8) node[right] {$\mathbf e_u$};
 \node at (1.5,-1.5) {$L/R=2.5$};
\end{scope}
\begin{scope}[shift={(12.4,-.05)}]
 \node[font=\bfseries] at (0,1.2) {Cross-section};
 \fill[beam!15] (0,0) circle (.78);
 \draw[beam] (0,0) circle (.78);
 \draw[->] (-1,0)--(1,0) node[right] {$u$};
 \draw[->] (0,-1)--(0,1) node[right] {$y$};
 \draw[->] (0,0)--node[above,sloped] {$a$}(.55,.55);
 \node[align=center] at (0,-1.45) {$\sigma_u=\sigma_y$\\$=10$ mm};
\end{scope}
\end{tikzpicture}
