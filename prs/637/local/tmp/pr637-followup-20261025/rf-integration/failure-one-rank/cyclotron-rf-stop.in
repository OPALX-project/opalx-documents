// Deterministic one-particle regression; no self fields or random sampling.
// Keep only the forced final statistics row; write final phase-space.
// Lattice, maps and launch are from the existing cyclotron guard fixtures.
OPTION, VERSION=10900, PSDUMPFREQ=0, ASCIIDUMP=TRUE, STATDUMPFREQ=1000000000, STEPINFOFQ=1000;
OPTION, ENABLELINEARTRANSFERMAPS=FALSE;
TC1: TRIMCOIL, TYPE="PSI-BFIELD-MIRRORED", RMIN=4.350, RMAX=4.470, BMAX=0, SLPTC=600;
