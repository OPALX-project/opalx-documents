SM7: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8, TRIMCOIL={"TC1"}, X=3.0301474099156063, Z=-4.2476062479156074, THETA=-5.497787143782138;
RF0: RFCAVITY, TYPE="SINGLEGAP", FMAPFN="rffield1.dat", VOLT=0.84699999999999998, FREQ=50.65, PHI0=204, RMIN=1.00338, RMAX=6.20338, GAPWIDTH=0.3, X=0.93530282952203514, Z=-2.2549211204242208, THETA=-0.6108652381980153;
