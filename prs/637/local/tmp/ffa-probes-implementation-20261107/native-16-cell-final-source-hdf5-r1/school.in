SCHOOL: RING=(PROBE1,PROBE2,PROBE3,PROBE4,PROBE5,PROBE6,PROBE7,PROBE8,PROBE9,
        PROBE10,PROBE11,PROBE12,PROBE13,PROBE14,PROBE15,PROBE16,GAP00,C00_F,
        GAP02,C00_D,GAP04,C01_F,GAP06,C01_D,GAP08,C02_F,GAP10,C02_D,GAP12,C03_F,
        GAP14,C03_D,GAP16,C04_F,GAP18,C04_D,GAP20,C05_F,GAP22,C05_D,GAP24,C06_F,
        GAP26,C06_D,GAP28,C07_F,GAP30,C07_D,GAP32,C08_F,GAP34,C08_D,GAP36,C09_F,
        GAP38,C09_D,GAP40,C10_F,GAP42,C10_D,GAP44,C11_F,GAP46,C11_D,GAP48,C12_F,
        GAP50,C12_D,GAP52,C13_F,GAP54,C13_D,GAP56,C14_F,GAP58,C14_D,GAP60,C15_F,
        GAP62,C15_D,GAP_FINAL);

DIST: DISTRIBUTION, TYPE=FROMFILE, FNAME="particles.dat", NPARTDIST=N_PARTICLES;
SOURCE: EMISSIONSOURCE, DISTRIBUTION=DIST;
SOURCES: EMISSIONSOURCELIST=(SOURCE);

BEAM1: BEAM, PARTICLE=PROTON, MASS=P_MASS/1000, NALLOC=N_PARTICLES, SOURCES=SOURCES, BCHARGE=BUNCH_CHARGE, CHARGE=P_CHARGE;

FS: FIELDSOLVER, TYPE=NONE, NX=N_GRID, NY=N_GRID, NZ=N_GRID;

TRACK, LINE=SCHOOL, BEAM=BEAM1, DT={TRACK_DT},
       MAXSTEPS=TRACK_MAXSTEPS, ZSTOP=TRACK_ZSTOP;

RUN, METHOD="PARALLEL", FIELDSOLVER=FS;

ENDTRACK;
STOP;
