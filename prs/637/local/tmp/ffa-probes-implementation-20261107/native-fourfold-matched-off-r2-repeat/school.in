       RADIAL_NEG_EXTENT=RADIAL_NEG, RADIAL_POS_EXTENT=RADIAL_POS, HEIGHT=MAGNET_HEIGHT, AZIMUTHAL_EXTENT=AZIMUTHAL_EXTENT, X=R0*(COS((PI/2-(S3_P2_F_PHI)-((BF3_CENTRE_LENGTH/2)+(BF3_CENTRE_LENGTH/2))/R0))-1), Y=0, Z=R0*SIN((PI/2-(S3_P2_F_PHI)-((BF3_CENTRE_LENGTH/2)+(BF3_CENTRE_LENGTH/2))/R0)), THETA=-(PI/2-(S3_P2_F_PHI)-((BF3_CENTRE_LENGTH/2)+(BF3_CENTRE_LENGTH/2))/R0), PHI=0, PSI=0;

