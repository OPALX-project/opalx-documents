       RADIAL_NEG_EXTENT=RADIAL_NEG, RADIAL_POS_EXTENT=RADIAL_POS, HEIGHT=MAGNET_HEIGHT, AZIMUTHAL_EXTENT=GAP62_LENGTH/2+LAMBDA, X=R0*(COS(GAP62_PHI)-1), Y=0, Z=R0*SIN(GAP62_PHI), THETA=-GAP62_PHI, PHI=0, PSI=0;

S3_P3_D: SCALINGFFAMAGNET, END_FIELD_MODEL=S3_P3_D_END, R0=R0, B0=-BD4, FIELD_INDEX=K_VAL, TAN_DELTA=-TAN(SPIRAL_ANGLE), MAX_Y_POWER=Y_ORDER,
