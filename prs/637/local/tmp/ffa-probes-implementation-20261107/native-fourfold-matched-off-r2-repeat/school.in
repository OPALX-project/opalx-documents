SCHOOL: RING=(GAP00,S0_P0_F,GAP02,S0_P0_D,GAP04,S0_P1_F,GAP06,S0_P1_D,GAP08,
        S0_P2_F,GAP10,S0_P2_D,GAP12,S0_P3_F,GAP14,S0_P3_D,GAP16,S1_P0_F,GAP18,
        S1_P0_D,GAP20,S1_P1_F,GAP22,S1_P1_D,GAP24,S1_P2_F,GAP26,S1_P2_D,GAP28,
        S1_P3_F,GAP30,S1_P3_D,GAP32,S2_P0_F,GAP34,S2_P0_D,GAP36,S2_P1_F,GAP38,
        S2_P1_D,GAP40,S2_P2_F,GAP42,S2_P2_D,GAP44,S2_P3_F,GAP46,S2_P3_D,GAP48,
        S3_P0_F,GAP50,S3_P0_D,GAP52,S3_P1_F,GAP54,S3_P1_D,GAP56,S3_P2_F,GAP58,
        S3_P2_D,GAP60,S3_P3_F,GAP62,S3_P3_D,GAP_FINAL);

DIST: DISTRIBUTION, TYPE=FROMFILE, FNAME="particles.dat", NPARTDIST=N_PARTICLES;
SOURCE: EMISSIONSOURCE, DISTRIBUTION=DIST;
SOURCES: EMISSIONSOURCELIST=(SOURCE);

BEAM1: BEAM, PARTICLE=PROTON, MASS=P_MASS/1000, NALLOC=N_PARTICLES, SOURCES=SOURCES, BCHARGE=BUNCH_CHARGE, CHARGE=P_CHARGE;

FS: FIELDSOLVER, TYPE=NONE, NX=N_GRID, NY=N_GRID, NZ=N_GRID;

TRACK, LINE=SCHOOL, BEAM=BEAM1, DT={TRACK_DT},
       MAXSTEPS=TRACK_MAXSTEPS, ZSTOP=TRACK_ZSTOP;

RUN, METHOD="PARALLEL", FIELDSOLVER=FS;

ENDTRACK;
STOP;
