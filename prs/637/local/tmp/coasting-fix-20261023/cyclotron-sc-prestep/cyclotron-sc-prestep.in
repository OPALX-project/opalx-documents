// Deterministic 262144-particle bunch, one MPI rank, OPEN 32^3, one bin.
// Final statistics only; the MIDPOINT and PRESTEP cases have separate references.
OPTION, VERSION=10900, PSDUMPFREQ=0, STATDUMPFREQ=1000000000, ASCIIDUMP=TRUE;
OPTION, ENABLELINEARTRANSFERMAPS=FALSE;
TITLE, STRING="72 MeV cyclotron: 12-step PRESTEP space-charge regression";
TC1: TRIMCOIL, TYPE="PSI-BFIELD-MIRRORED", RMIN=4.350, RMAX=4.470,
     BMAX=1.4E-3, SLPTC=600.0;
SM0: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=3.3-2.1315035447000281, Y=0, Z=0,
    THETA=0, PHI=0, PSI=0;
SM1: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=2.3334523779156067-2.1315035447000281, Y=0, Z=2.3334523779156067,
    THETA=-0.7853981633974483, PHI=0, PSI=0;
SM2: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=2.0206672185931328e-16-2.1315035447000281, Y=0, Z=3.3,
    THETA=-1.5707963267948966, PHI=0, PSI=0;
SM3: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=-2.3334523779156067-2.1315035447000281, Y=0, Z=2.3334523779156067,
    THETA=-2.356194490192345, PHI=0, PSI=0;
SM4: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=-3.3-2.1315035447000281, Y=0, Z=4.0413344371862655e-16,
    THETA=-3.141592653589793, PHI=0, PSI=0;
SM5: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=-2.333452377915607-2.1315035447000281, Y=0, Z=-2.3334523779156067,
    THETA=-3.9269908169872414, PHI=0, PSI=0;
SM6: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=-6.062001655779398e-16-2.1315035447000281, Y=0, Z=-3.3,
    THETA=-4.71238898038469, PHI=0, PSI=0;
SM7: CYCLOTRONSECTOR, FMAPFN="bfield.dat", SYM=8,
    RMIN=1.9, RMAX=4.7, VMIN=-0.05, VMAX=0.05, TRIMCOIL={"TC1"},
    X=2.3334523779156062-2.1315035447000281, Y=0, Z=-2.333452377915607,
    THETA=-5.497787143782138, PHI=0, PSI=0;
MYCYCL: RING=(SM0,SM1,SM2,SM3,SM4,SM5,SM6,SM7), X=2.1315035447000281;
DIST0: DISTRIBUTION, TYPE=FROMFILE, FNAME="gauss.dat", NPARTDIST=262144;
ES0: EMISSIONSOURCE, DISTRIBUTION=DIST0;
SOURCES0: EMISSIONSOURCELIST=(ES0);
SCBIN: BINNING, MAXBINS=1, PARAMETER=GAMMAZ, ADAPTIVEBINNING=FALSE, TABLEPRINTFREQ=1, DUMPBINSFILE="NONE";
FS0: FIELDSOLVER, TYPE=OPEN, BINS=SCBIN, NX=32, NY=32, NZ=32,
 PARFFTX=TRUE, PARFFTY=TRUE, PARFFTZ=TRUE,
 BCFFTX=OPEN, BCFFTY=OPEN, BCFFTZ=OPEN, BBOXINCR=2, GREENSF=STANDARD;
BEAM0: BEAM, PARTICLE=PROTON, NALLOC=262144, BCHARGE=3.9486673247778873e-11, SOURCES=SOURCES0, CHARGE=1;
TRACK, LINE=MYCYCL, BEAM=BEAM0, MAXSTEPS=12, DT=1.6452780519907864e-10, ZSTOP=1e6;
RUN, METHOD="PARALLEL", FIELDSOLVER=FS0, SCFIELDUPDATE="PRESTEP";
ENDTRACK;
QUIT;
