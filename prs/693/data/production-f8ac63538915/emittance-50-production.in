// 50 pi mm mrad KV beam; production
// Formatting only: numerical values and statement tokens preserved.

OPTION,
    ECHO=FALSE,
    ENABLEHDF5=TRUE,
    ASCIIDUMP=FALSE,
    ENABLELINEARTRANSFERMAPS=FALSE,
    PSDUMPFREQ=2000000,
    STATDUMPFREQ=1000,
    BOUNDPDESTROY=0,
    STEPINFOFQ=1000,
    REPARTFREQ=0,
    VERSION=10900;

// PyFFA config_Bmap.py; exact logistic-product normalization.

CALL, FILE="../lattice.in";


TUNE0: PROBE,
    XSTART=-2000,
    YSTART=0,
    XEND=2000,
    YEND=0,
    STEP=1,
    OUTFN="station-0";

TUNE1: PROBE,
    XSTART=-4928.932188134524,
    YSTART=7071.0678118654751,
    XEND=-2100.5050633883347,
    YEND=9899.4949366116634,
    STEP=1,
    OUTFN="station-1";

TUNE2: PROBE,
    XSTART=-12000,
    YSTART=10000,
    XEND=-12000,
    YEND=14000,
    STEP=1,
    OUTFN="station-2";

TUNE3: PROBE,
    XSTART=-19071.067811865476,
    YSTART=7071.067811865476,
    XEND=-21899.494936611663,
    YEND=9899.4949366116653,
    STEP=1,
    OUTFN="station-3";

TUNE4: PROBE,
    XSTART=-22000,
    YSTART=1.2246467991473533e-12,
    XEND=-26000,
    YEND=1.7145055188062945e-12,
    STEP=1,
    OUTFN="station-4";

TUNE5: PROBE,
    XSTART=-19071.067811865476,
    YSTART=-7071.0678118654751,
    XEND=-21899.494936611667,
    YEND=-9899.4949366116634,
    STEP=1,
    OUTFN="station-5";

TUNE6: PROBE,
    XSTART=-12000.000000000002,
    YSTART=-10000,
    XEND=-12000.000000000002,
    YEND=-14000,
    STEP=1,
    OUTFN="station-6";

TUNE7: PROBE,
    XSTART=-4928.9321881345259,
    YSTART=-7071.0678118654769,
    XEND=-2100.5050633883366,
    YEND=-9899.4949366116671,
    STEP=1,
    OUTFN="station-7";

PRAB_RING: RING=(
    C00_0,C00_1,C00_2,C00_3,C00_4,
    C01_0,C01_1,C01_2,C01_3,C01_4,
    C02_0,C02_1,C02_2,C02_3,C02_4,
    C03_0,C03_1,C03_2,C03_3,C03_4,
    C04_0,C04_1,C04_2,C04_3,C04_4,
    C05_0,C05_1,C05_2,C05_3,C05_4,
    C06_0,C06_1,C06_2,C06_3,C06_4,
    C07_0,C07_1,C07_2,C07_3,C07_4,
    C08_0,C08_1,C08_2,C08_3,C08_4,
    C09_0,C09_1,C09_2,C09_3,C09_4,
    C10_0,C10_1,C10_2,C10_3,C10_4,
    C11_0,C11_1,C11_2,C11_3,C11_4,
    C12_0,C12_1,C12_2,C12_3,C12_4,
    C13_0,C13_1,C13_2,C13_3,C13_4,
    C14_0,C14_1,C14_2,C14_3,C14_4,
    C15_0,C15_1,C15_2,C15_3,C15_4,
    TUNE0,TUNE1,TUNE2,TUNE3,TUNE4,
    TUNE5,TUNE6,TUNE7
);

DIST: DISTRIBUTION,
    TYPE=FROMFILE,
    FNAME="../emittance-50-particles.dat",
    NPARTDIST=131072;

SOURCE: EMISSIONSOURCE,
    DISTRIBUTION=DIST;

SOURCES: EMISSIONSOURCELIST=(SOURCE);

BEAM1: BEAM,
    PARTICLE=PROTON,
    MASS=0.9382720813,
    PC=0.80806141399029818,
    REFDIRECTION={0.13417486829090361,0,0.99095767049814931},
    NALLOC=131072,
    SOURCES=SOURCES,
    BCHARGE=3.33252739872e-06,
    CHARGE=1;

FS: FIELDSOLVER,
    TYPE="FFT2D5",
    FFT2D5MODEL="ORIGINAL",
    PIPEMODE="NONE",
    CLOSEDRING=TRUE,
    REFPATHFNAME="reference-path.dat",
    NX=128,
    NY=128,
    NZ=763,
    PIPESIZEX=.4,
    PIPESIZEY=.4,
    BEAMR=.02,
    PARFFTX=FALSE,
    PARFFTY=FALSE,
    PARFFTZ=TRUE;

TRACK,
    LINE=PRAB_RING,
    BEAM=BEAM1,
    DT={1.9999999999999999e-11},
    MAXSTEPS=182825,
    ZSTOP=1000000;

RUN,
    METHOD="PARALLEL",
    FIELDSOLVER=FS,
    SCFIELDUPDATE="MIDPOINT";

ENDTRACK;

STOP;

